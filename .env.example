# Local development only. Replace the example password before other use.
POSTGRES_DB=electronics
POSTGRES_USER=electronics
POSTGRES_PASSWORD=local_demo_only
DATABASE_URL=postgresql+psycopg://electronics:local_demo_only@localhost:5432/electronics
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional preview, instead of PostgreSQL:
# DATABASE_URL=sqlite:///./preview.db
# No LLM credential is needed for Day 1.

# Planned Day 2 API configuration (not consumed by the current Day 1 app):
# GEMINI_API_KEY=enter_privately_on_your_machine
